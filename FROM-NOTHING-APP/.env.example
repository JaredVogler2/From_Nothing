# FOCUS settings (FOCUS_* allowlist, see focus/config.py). Copy to .env or set in the
# hosting platform. NEVER put real secrets in this file or commit a filled-in copy.

# fixture | live
FOCUS_MODE=fixture
# FOCUS_APP_ROOT=/absolute/path/to/FROM-NOTHING-APP
FOCUS_BIND=127.0.0.1
FOCUS_PORT=5055
FOCUS_POLICY_ID=rebuild-v1
FOCUS_SCENARIO_ID=manufacturing_demo
FOCUS_SCOPE_KEY=DEMO-787
FOCUS_WORKER_BUDGET_SECONDS=30
FOCUS_SOLVER_ENABLED=false
# none | mock | recorded | bcai
FOCUS_LLM_PROVIDER=none

# Live SQL Server (read principal for sources; separate principals stage/sign/install)
FOCUS_SQL_HOST=SQL-D-22D10090
FOCUS_SQL_DATABASE=SHARED
FOCUS_SQL_USER=
FOCUS_SQL_PASSWORD=
FOCUS_SQL_READ_TIMEOUT_SECONDS=60
# JSON map dataset -> IANA timezone for datetime2 source columns (mandatory in live mode)
FOCUS_SOURCE_TIMEZONE_MAP_JSON=

# Secrets: provide through the platform secret store, not this file
FOCUS_SESSION_SECRET=
FOCUS_SIGN_KEY_ID=
# e.g. env:FOCUS_SIGN_KEY_VALUE or vcap:focus-secrets/sign_key (signer worker only)
FOCUS_SIGN_KEY_REF=
FOCUS_BCAI_ENDPOINT=
FOCUS_BCAI_CREDENTIAL_REF=

# Identity: fixture (demo only) | posit_connect | trusted_header | none
# FOCUS_IDENTITY_PROVIDER=posit_connect
# FOCUS_TRUSTED_USER_HEADER=X-Forwarded-User
# Server-owned grants: {"subjects": {"posit:alice": ["reader","manager"]}, "groups": {"focus-leads": ["team_lead"]}, "default": ["reader"]}
FOCUS_GRANTS_JSON=

# API / MCP
FOCUS_MCP_ENABLED=false
# Tanzu: names of user-provided services holding SQL credentials and secrets
# FOCUS_SQL_SERVICE_NAME=focus-sql
# FOCUS_SECRETS_SERVICE_NAME=focus-secrets
