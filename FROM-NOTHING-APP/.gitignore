# virtual environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# native core build output (rebuilt by `pip install ./native` or maturin)
native/target/
native/dist/

# persistent fixture runtime (regenerated by demo-bootstrap/demo-run; never committed)
fixtures/runtime/

# local secrets and deployment state
.env
.env.*
!.env.example
rsconnect-python/
*.key

# test artifacts that are regenerated
tests/ui/screenshots/
.coverage
